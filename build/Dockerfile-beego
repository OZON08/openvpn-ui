# build.sh replaces the placeholder below with the Go image for the host architecture
FROM DEFINE-YOUR-ARCH

LABEL maintainer="OZON08 <65833863+OZON08@users.noreply.github.com>"

# Set the working directory to /beego and installing dependencies
WORKDIR /beego
RUN apt-get update && apt-get install git musl-tools -y

# Enable go modules
ENV GO111MODULE=on
ENV CGO_ENABLED=1

# Copy the go.mod and go.sum files to the container
COPY go.mod go.sum ./

# Download the dependencies
RUN go mod download

# Install the beego and bee packages — pinned to a specific release for reproducible builds
RUN go install github.com/beego/bee/v2@v2.3.0

# Setting working directory to /app and getting qrencode from github
WORKDIR /app
RUN git clone --depth 1 --branch v0.2.0 https://github.com/OZON08/qrencode

# Set the working directory to /
WORKDIR /
